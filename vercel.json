{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm ci --prefix notebook && npm run typecheck && npm run lint && npm run build",
  "outputDirectory": "out",
  "functions": {
    "api/privileged.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/privileged/api/:path*",
      "destination": "/api/privileged?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/privileged/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/privileged/login/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/privileged/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
